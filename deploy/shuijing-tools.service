[Unit]
Description=Shuijing Tools Flask service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=shuijing
Group=Users
WorkingDirectory=/vol2/1000/backup/ShuijingTools
EnvironmentFile=/vol2/1000/backup/ShuijingTools/.env
Environment=PYTHONUNBUFFERED=1
Environment=DB_DRIVER=mysql
Environment=STORAGE_ROOT=/vol2/1000/backup/ShuijingTools/storage
Environment=MAX_CONTENT_LENGTH=10737418240
ExecStart=/vol2/1000/backup/ShuijingTools/.venv/bin/gunicorn --chdir /vol2/1000/backup/ShuijingTools -w 2 --timeout 600 -b 127.0.0.1:18080 --access-logfile /vol2/1000/backup/ShuijingTools/logs/shuijing-tools.log --error-logfile /vol2/1000/backup/ShuijingTools/logs/shuijing-tools.log --capture-output backend.wsgi:app
Restart=always
RestartSec=5
StandardOutput=append:/vol2/1000/backup/ShuijingTools/logs/shuijing-tools.log
StandardError=append:/vol2/1000/backup/ShuijingTools/logs/shuijing-tools.log

[Install]
WantedBy=multi-user.target
